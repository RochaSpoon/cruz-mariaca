---
import Player from '../layouts/Player.astro';
import { buildCards, type Lesson } from '../lib/lessons';
import translated from '../data/translated.json';
interface Props { lesson: Lesson; full: Lesson[]; lang?: 'en' | 'es' | 'la' }
const { lesson, full, lang = 'en' } = Astro.props;
const d = lesson.data;
const cards = buildCards(lesson, full, lang);
const total = cards.length + 1; // plus the finish screen
const checks = cards.filter((c) => c.kind === 'check').length;
const trLangs = ((translated as Record<string, string[]>)[d.slug] ?? []).join(',');
---
<Player title={d.title} lang={lang}>
  <div class="p-shell" data-slug={d.slug} data-total={total} data-checks={checks} data-lang={lang} data-tr={trLangs}>
    <header class="p-top">
      <a class="p-close" href="/" aria-label="Leave the lesson" data-t-attr="aria-label"><span aria-hidden="true"></span></a>
      <div class="p-bar" role="progressbar" aria-label="Lesson progress" data-t-attr="aria-label" aria-valuemin="0" aria-valuemax={total} aria-valuenow="1"><i></i></div>
      <span class="p-count"><b data-at>1</b> / {total}</span>
    </header>

    <main class="deck" id="deck" tabindex="-1">
      {cards.map((c, i) => (
        <section class={`slide s-${c.kind}`} data-i={i} aria-label={`Screen ${i + 1} of ${total}`}>
          <div class="card">
            {c.kind === 'intro' && (
              <>
                <p class="label" data-t>{c.unit}</p>
                <h1 class="title">{c.title}</h1>
                <p class="meta-line"><span data-t>About</span> {c.minutes} <span data-t>minutes. Press Continue to start.</span></p>
                <p class="note-box" data-untr hidden><span data-t>This lesson is not translated yet. It is shown in English.</span></p>
                {c.heavy && <p class="note-box"><b data-t>A hard topic.</b> <span data-t>This lesson is about something serious. Read it when you are ready, or leave it for another day.</span></p>}
                {c.crisis && <p class="note-box"><b data-t>If you are in crisis right now,</b> <span data-t>call or text 988 in the United States to reach the Suicide and Crisis Lifeline.</span></p>}
                <p class="meta-line unrev" data-t>Sources checked against the original texts. Not yet reviewed by a priest or catechist.</p>
              </>
            )}
            {(c.kind === 'big' || c.kind === 'teach' || c.kind === 'today' || c.kind === 'stakes') && (
              <>
                <p class="label" data-t>{c.label}</p>
                <p class={c.kind === 'big' ? 'say big' : 'say'} set:html={c.html} />
              </>
            )}
            {c.kind === 'scripture' && (
              <>
                <p class="label" data-t>{c.label}</p>
                <blockquote class="verse"><p set:html={c.html} />{c.cite && <cite>{c.cite}</cite>}</blockquote>
              </>
            )}
            {c.kind === 'list' && (
              <>
                <p class="label" data-t>{c.label}</p>
                <ul class="plain-list">{c.items.map((it) => <li set:html={it} />)}</ul>
              </>
            )}
            {c.kind === 'actions' && (
              <>
                <p class="label" data-t>{c.label}</p>
                <p class="say small" data-t>Pick one to try today.</p>
                <ul class="moves" role="radiogroup" aria-label="Pick one to try today" data-t-attr="aria-label">
                  {c.items.map((it) => <li><button type="button" role="radio" aria-checked="false" class="move" set:html={it} /></li>)}
                </ul>
              </>
            )}
            {c.kind === 'check' && (
              <div class="check" data-xp={c.xp}>
                <p class="label" data-t>Quick check</p>
                <p class="say" data-t>{c.q}</p>
                <ul class="opts">
                  {c.options.map((o) => <li><button type="button" class="opt" data-ok={o.ok ? '1' : '0'}>{o.t}</button></li>)}
                </ul>
                <p class="feedback" aria-live="polite" data-hint={c.hint}></p>
              </div>
            )}
            {c.kind === 'sources' && (
              <>
                <p class="label" data-t>{c.label}</p>
                <ul class="plain-list srcs">{c.items.map((it) => <li set:html={it} />)}</ul>
              </>
            )}
          </div>
        </section>
      ))}
      <section class="slide s-finish" data-i={cards.length} aria-label="Lesson complete" data-t-attr="aria-label">
        <div class="card">
          <p class="label" data-t>Lesson complete</p>
          <h2 class="title done-title" data-t>That is it for this one.</h2>
          <p class="xp-big" data-xpbig hidden></p>
          <p class="say" data-result data-t>Press Finish to save it.</p>
          <p class="say small" data-goal></p>
          <p><button type="button" class="btn ghost" id="share" data-t>Share</button></p>
        </div>
      </section>
    </main>

    <footer class="p-bottom">
      <div class="msg" id="msg" aria-live="polite"><i id="msg-i" aria-hidden="true"></i><div><b id="msg-t"></b><span id="msg-s"></span></div></div>
      <button type="button" class="btn ghost" id="prev" hidden data-t>Back</button>
      <button type="button" class="btn big" id="next" data-t>Continue</button>
    </footer>
  </div>

  <noscript><p class="ns">This lesson plays one screen at a time and needs JavaScript. The text above is all here, in order.</p></noscript>

  <script>
    import { complete, load, streak, doneToday, totalXP } from '../lib/progress';
    import { T, applyLang, getLang, setLang } from '../lib/lang';
    const shell = document.querySelector<HTMLElement>('.p-shell')!;
    const deck = document.getElementById('deck')!;
    const slides = [...deck.querySelectorAll<HTMLElement>('.slide')];
    const total = slides.length;
    const slug = shell.dataset.slug!;
    // A translated page sets the language. An English page follows the visitor's choice, or says it is untranslated.
    const pageLang = shell.dataset.lang as 'en' | 'es' | 'la';
    if (pageLang !== 'en') setLang(pageLang);
    else {
      const pref = getLang();
      if (pref !== 'en' && (shell.dataset.tr ?? '').split(',').includes(pref)) location.replace(`/${pref}/learn/${slug}/`);
      else if (pref !== 'en') shell.querySelector<HTMLElement>('[data-untr]')?.removeAttribute('hidden');
    }
    applyLang(getLang());
    const home = '/';
    const bar = shell.querySelector<HTMLElement>('.p-bar i')!;
    const barEl = shell.querySelector<HTMLElement>('.p-bar')!;
    const at = shell.querySelector<HTMLElement>('[data-at]')!;
    const next = document.getElementById('next') as HTMLButtonElement;
    const prev = document.getElementById('prev') as HTMLButtonElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, finished = false, correct = 0, pick = '';
    const resolved = new WeakSet<HTMLElement>();
    const selected = new Map<HTMLElement, HTMLButtonElement>();
    const bottom = document.querySelector<HTMLElement>('.p-bottom')!;

    const h = () => deck.clientHeight;
    const go = (i: number) => deck.scrollTo({ top: Math.max(0, Math.min(total - 1, i)) * h(), behavior: reduce ? 'auto' : 'smooth' });

    function paint() {
      const pct = ((cur + 1) / total) * 100;
      bar.style.width = pct + '%'; at.textContent = String(cur + 1); barEl.setAttribute('aria-valuenow', String(cur + 1));
      prev.hidden = cur === 0 || finished;
      const slide = slides[cur];
      const isCheck = !!slide.querySelector('.check');
      const gate = isCheck && !resolved.has(slide);
      const last = cur === total - 1;
      if (!(isCheck && resolved.has(slide))) { bottom.className = 'p-bottom'; }
      if (finished) { next.textContent = T('Back to the path'); next.disabled = false; }
      else if (gate) { next.textContent = T('Check'); next.disabled = !selected.has(slide); }
      else { next.textContent = T(last ? 'Finish' : 'Continue'); next.disabled = false; }
      slides.forEach((s, i) => s.toggleAttribute('inert', Math.abs(i - cur) > 0 && false));
    }

    let raf = 0;
    deck.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(() => { const i = Math.round(deck.scrollTop / h()); if (i !== cur) { cur = i; paint(); } }); }, { passive: true });

    next.addEventListener('click', () => {
      if (finished) { location.href = '/'; return; }
      const sl = slides[cur];
      if (sl.querySelector('.check') && !resolved.has(sl)) return check(sl);
      if (cur === total - 1) return finish();
      go(cur + 1);
    });
    prev.addEventListener('click', () => go(cur - 1));
    document.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('button') && (e.key === 'Enter' || e.key === ' ')) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); if (!next.disabled) next.click(); }
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); if (!prev.hidden) prev.click(); }
      if (e.key === 'Escape') location.href = '/';
    });

    // Quick checks: pick an answer, press Check, then see the result in the bottom bar.
    deck.querySelectorAll<HTMLElement>('.check').forEach((box) => {
      box.querySelectorAll<HTMLButtonElement>('.opt').forEach((b) => b.addEventListener('click', () => {
        const slide = box.closest<HTMLElement>('.slide')!;
        if (resolved.has(slide)) return;
        box.querySelectorAll('.opt').forEach((o) => o.classList.remove('sel'));
        b.classList.add('sel'); selected.set(slide, b); paint();
      }));
    });
    function check(slide: HTMLElement) {
      const b = selected.get(slide); if (!b) return;
      const box = slide.querySelector<HTMLElement>('.check')!;
      resolved.add(slide);
      const ok = b.dataset.ok === '1';
      box.querySelectorAll<HTMLButtonElement>('.opt').forEach((o) => { o.disabled = true; o.classList.remove('sel'); if (o.dataset.ok === '1') o.classList.add('ok'); });
      const t = document.getElementById('msg-t')!, sub = document.getElementById('msg-s')!, ic = document.getElementById('msg-i')!;
      if (ok) { correct++; t.textContent = T('Nicely done!'); sub.textContent = '+' + box.dataset.xp + ' XP'; ic.textContent = '✓'; bottom.className = 'p-bottom good'; }
      else {
        b.classList.add('no');
        const right = box.querySelector<HTMLElement>('.opt.ok')?.textContent ?? '';
        const hint = box.querySelector<HTMLElement>('.feedback')?.dataset.hint ?? '';
        t.textContent = T('Not quite'); sub.textContent = T('Right answer:') + ' ' + right + (hint ? ' ' + hint : ''); ic.textContent = '✕'; bottom.className = 'p-bottom bad';
      }
      paint();
    }

    // "Pick one to try today"
    deck.querySelectorAll<HTMLButtonElement>('.move').forEach((b) => b.addEventListener('click', () => {
      deck.querySelectorAll('.move').forEach((o) => { o.setAttribute('aria-checked', 'false'); o.classList.remove('on'); });
      b.setAttribute('aria-checked', 'true'); b.classList.add('on'); pick = (b.textContent ?? '').trim().slice(0, 140);
    }));

    function finish() {
      const xp = 20 + correct * 5;
      const before = doneToday(load());
      const s = complete(slug, xp, pick || undefined);
      finished = true;
      const res = deck.querySelector<HTMLElement>('[data-result]')!;
      const big = deck.querySelector<HTMLElement>('[data-xpbig]')!; big.textContent = `+${xp} XP`; big.hidden = false;
      res.textContent = `${totalXP(s)} ${T('XP in all.')} ${streak(s)} ${T('day streak.')}`;
      const goal = deck.querySelector<HTMLElement>('[data-goal]')!;
      goal.textContent = T(before
        ? 'You had already done a lesson today. More are on the path whenever you want them, and nothing is lost if you stop here.'
        : 'Today’s goal is done. More lessons are on the path whenever you want them, and nothing is lost if you stop here.');
      paint();
    }

    // Share the lesson link (phone share sheet if there is one, otherwise copy it).
    const share = document.getElementById('share') as HTMLButtonElement | null;
    share?.addEventListener('click', async () => {
      const data = { title: document.title, url: location.href.split('#')[0] };
      try { if (navigator.share) { await navigator.share(data); return; } } catch { /* cancelled */ }
      try { await navigator.clipboard.writeText(data.url); share.textContent = T('Copied'); setTimeout(() => { share.textContent = T('Share'); }, 1800); } catch { /* ignore */ }
    });

    // Start on the first screen; arrow keys and Continue work from here.
    deck.focus({ preventScroll: true }); paint();
  </script>
</Player>
