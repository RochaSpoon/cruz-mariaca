---
// "Today" at a glance: season, color, and the one task for the day. Corrected for the visitor's own date in the browser.
import { getCollection } from 'astro:content';
import { seasonFor } from '../lib/liturgical';
import { dayNumberForUTC } from '../lib/daily';
const all = (await getCollection('daily')).sort((a, b) => a.data.day - b.data.day);
const n = all.length ? dayNumberForUTC(new Date()) : 0;
const today = all.find((e) => e.data.day === n) ?? all[0];
const season = seasonFor(new Date());
const COLOR: Record<string, string> = { green: 'Green', violet: 'Violet', white: 'White', red: 'Red', rose: 'Rose' };
const index = Object.fromEntries(all.map((e) => [e.data.day, { ref: e.data.reading_ref, q: e.data.question, m: e.data.minutes }]));
---
<section class="today" aria-labelledby="today-h" data-today>
  <p class="rubric sc" data-t>Today</p>
  <h2 id="today-h" data-date></h2>
  <p class="today-season"><span data-season>{season.label}</span><span data-t>, vestments</span> <span data-color>{COLOR[season.color]}</span></p>
  {today && (
    <>
      <p class="rubric sc" data-t>The task for today</p>
      <ol class="task">
        <li><span data-t>Read</span> <strong data-ref>{today.data.reading_ref}</strong> <span class="mins">(<span data-min>{today.data.minutes}</span> <span data-t>min</span>)</span></li>
        <li><span data-t>Think about this:</span> <em data-q>{today.data.question}</em></li>
      </ol>
      <p><a class="button" href={`/daily/${today.data.day}/`} data-open data-t>Open today's reading</a></p>
    </>
  )}
  <script id="today-index" type="application/json" set:html={JSON.stringify(index)}></script>
</section>
<script>
  import { dayNumberForLocal } from '../lib/daily';
  import { seasonForLocalDate } from '../lib/liturgical';
  import { T, getLang, dateTag } from '../lib/lang';
  const root = document.querySelector<HTMLElement>('[data-today]');
  if (root) {
    const now = new Date();
    const set = (sel: string, text: string) => { const el = root.querySelector(sel); if (el) el.textContent = text; };
    const s = seasonForLocalDate(now);
    const paintDate = () => {
      const lang = getLang();
      set('[data-date]', now.toLocaleDateString(dateTag(lang), { weekday: 'long', month: 'long', day: 'numeric' }));
      set('[data-season]', T(s.label, lang)); set('[data-color]', T(s.color[0].toUpperCase() + s.color.slice(1), lang));
    };
    paintDate(); document.addEventListener('cm-lang', paintDate);
    const idx = JSON.parse(root.querySelector('#today-index')?.textContent ?? '{}');
    const e = idx[dayNumberForLocal(now)];
    if (e) {
      set('[data-ref]', e.ref); set('[data-q]', e.q); set('[data-min]', String(e.m));
      const a = root.querySelector<HTMLAnchorElement>('[data-open]'); if (a) a.href = `/daily/${dayNumberForLocal(now)}/`;
    }
  }
</script>
