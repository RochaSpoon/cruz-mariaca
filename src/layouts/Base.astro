---
import '../styles/global.css';
import '../styles/extra.css';
import '../styles/app.css';
import '../styles/duo.css';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = 'What the Catholic Church teaches, with sources, for people exploring the faith.', noindex = false } = Astro.props;
const path = Astro.url.pathname;
const full = title === 'Cruz-Mariaca' ? title : `${title} | Cruz-Mariaca`;
const cur = (href: string) => (href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&display=swap" />
  </head>
  <body class="shelled">
    <a class="skip" href="#main">Skip to the content</a>
    <div class="shell">
      <aside class="side" aria-label="Main">
        <a class="logo" href="/">cruz-mariaca</a>
        <nav class="side-nav">
          <a href="/" aria-current={path === '/' || path.startsWith('/learn') ? 'page' : undefined}>
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3 3 14v14h9v-8h8v8h9V14z" fill="currentColor"/></svg><span>Learn</span>
          </a>
          <a href="/daily/" aria-current={path.startsWith('/daily') || path.startsWith('/today') ? 'page' : undefined}>
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M6 4h17a3 3 0 0 1 3 3v21H9a3 3 0 0 1-3-3zm4 5v3h12V9zm0 6v3h12v-3z" fill="currentColor"/></svg><span>Daily</span>
          </a>
          <a href="/library/" aria-current={path.startsWith('/library') || path.startsWith('/myths') || path.startsWith('/mass') || path.startsWith('/glossary') || path.startsWith('/start') ? 'page' : undefined}>
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 5h6v22H4zm9 0h6v22h-6zm9 3 6-1 3 20-6 1z" fill="currentColor"/></svg><span>Library</span>
          </a>
          <a href="/account/" aria-current={path.startsWith('/account') || path.startsWith('/about') || path.startsWith('/admin') ? 'page' : undefined}>
            <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="10" r="6" fill="currentColor"/><path d="M4 28c0-7 5-11 12-11s12 4 12 11z" fill="currentColor"/></svg><span>Profile</span>
          </a>
        </nav>
      </aside>
      <main id="main" class="content"><slot /></main>
    </div>
    <nav class="tabbar" aria-label="App">
      <a href="/" aria-label="Learn" aria-current={path === '/' || path.startsWith('/learn') ? 'page' : undefined}><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3 3 14v14h9v-8h8v8h9V14z" fill="currentColor"/></svg></a>
      <a href="/daily/" aria-label="Daily" aria-current={path.startsWith('/daily') || path.startsWith('/today') ? 'page' : undefined}><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M6 4h17a3 3 0 0 1 3 3v21H9a3 3 0 0 1-3-3zm4 5v3h12V9zm0 6v3h12v-3z" fill="currentColor"/></svg></a>
      <a href="/library/" aria-label="Library" aria-current={path.startsWith('/library') || path.startsWith('/myths') || path.startsWith('/mass') || path.startsWith('/glossary') || path.startsWith('/start') ? 'page' : undefined}><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 5h6v22H4zm9 0h6v22h-6zm9 3 6-1 3 20-6 1z" fill="currentColor"/></svg></a>
      <a href="/account/" aria-label="Profile" aria-current={path.startsWith('/account') || path.startsWith('/about') || path.startsWith('/admin') ? 'page' : undefined}><svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="10" r="6" fill="currentColor"/><path d="M4 28c0-7 5-11 12-11s12 4 12 11z" fill="currentColor"/></svg></a>
    </nav>
    <script>
      try { if (localStorage.getItem('cm-auth')) import('../lib/session').then((m) => m.init()); } catch {}
    </script>
  </body>
</html>
