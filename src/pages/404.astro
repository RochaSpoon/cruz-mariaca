---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <article class="guide">
    <h1 data-l="en la">That page is not here</h1>
    <h1 data-l="es">Esa página no está aquí</h1>
    <p data-l="en la">The link may be old or mistyped. Start from the lesson path or the library.</p>
    <p data-l="es">El enlace puede ser antiguo o tener un error. Empieza por el camino de lecciones o la biblioteca.</p>
    <p><a class="btn" href="/"><span data-l="en la">Go to the lessons</span><span data-l="es">Ir a las lecciones</span></a> <a class="btn ghost" href="/library/"><span data-l="en la">Library</span><span data-l="es">Biblioteca</span></a></p>
  </article>
</Base>
