---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AuthorityList from '../components/AuthorityList.astro';
import SourceList from '../components/SourceList.astro';
const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('src/content/pages/about.mdx is missing');
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <p class="rubric sc">How to read this site</p>
  <h1>{entry.data.title}</h1>
  <div class="prose plain">
    <Content components={{ AuthorityList }} />
  </div>
  <SourceList sources={entry.data.sources} />
</Base>
