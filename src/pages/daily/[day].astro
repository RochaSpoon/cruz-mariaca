---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MarkRead from '../../components/MarkRead.astro';
import SourceList from '../../components/SourceList.astro';
export async function getStaticPaths() {
  const all = await getCollection('daily');
  return all.map((e) => ({ params: { day: String(e.data.day) }, props: { e } }));
}
const { e } = Astro.props;
const d = e.data;
---
<Base title={`Daily Bread: ${d.reading_ref}`} description={d.summary}>
  <article>
    <p class="rubric sc"><a href="/daily/" style="color:inherit" data-t>Daily Bread</a>, <span data-t>reading</span> {d.day} <span data-t>of</span> 30</p>
    <h1>{d.reading_ref}</h1>
    <p class="meta"><span>{d.minutes} minute{d.minutes === 1 ? '' : 's'}</span></p>
    <div class="reading">
      <p>{d.reading_text}</p>
      <p class="cite">{d.reading_ref} <span class="sc">Douay-Rheims</span></p>
    </div>
    <div class="prose">
      <h3 data-t>A thought</h3>
      <p>{d.reflection}</p>
    </div>
    <div class="ask">
      <p class="rubric sc" data-t>A question</p>
      <p>{d.question}</p>
    </div>
    <p><a href={d.deeper_href}>{d.deeper_label}</a></p>
    <MarkRead slug="daily-today" on="I did this today" off="Undo" done="Noted." />
    <p class="finis" data-t>That is it for today.</p>
    <SourceList sources={d.sources} />
  </article>
</Base>
