---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SourceList from '../components/SourceList.astro';
const entry = await getEntry('pages', 'glossary');
if (!entry) throw new Error('glossary.mdx missing');
const { Content } = await render(entry);
const terms = [...(entry.data.terms ?? [])].sort((a, b) => a.term.localeCompare(b.term));
---
<Base title="Glossary" description={entry.data.summary}>
  <p class="rubric sc">Reference</p>
  <h1>Glossary</h1>
  <div class="prose plain"><Content /></div>
  <div class="finder">
    <label for="find">Find a term</label>
    <input id="find" type="search" autocomplete="off" />
  </div>
  <dl class="gloss" id="gloss">
    {terms.map((t) => (
      <div data-term={`${t.term} ${t.definition}`.toLowerCase()}>
        <dt id={t.id}>{t.term}{t.ccc && <span class="ref">{t.ccc}</span>}</dt>
        <dd>{t.definition}</dd>
      </div>
    ))}
  </dl>
  <p id="none" class="rubric" hidden>No term matches that.</p>
  <SourceList sources={entry.data.sources} />
  <script>
    const input = document.getElementById('find') as HTMLInputElement;
    const rows = [...document.querySelectorAll<HTMLElement>('#gloss > div')];
    const none = document.getElementById('none')!;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase(); let shown = 0;
      rows.forEach((r) => { const hit = !q || (r.dataset.term ?? '').includes(q); r.hidden = !hit; if (hit) shown++; });
      none.hidden = shown > 0;
    });
  </script>
</Base>
