---
import Base from '../layouts/Base.astro';
import TodayPanel from '../components/TodayPanel.astro';
import { getUnits } from '../lib/lessons';
const units = await getUnits();
const total = units.reduce((n, u) => n + u.lessons.length, 0);
const coming = units.reduce((n, u) => n + u.coming.length, 0);
---
<Base title="Cruz-Mariaca" description="Short Catholic lessons you can finish in a few minutes, one screen at a time.">
  <div class="app">
    <aside class="rail" aria-label="Your progress" data-t-attr="aria-label">
      <div class="stats" data-stats>
        <div class="stat streak" title="Day streak" data-t-attr="title"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M17 2c1 6 8 9 8 17a9 9 0 0 1-18 0c0-4 2-6 4-8 0 3 1 4 3 4 0-5 1-9 3-13z" fill="#ff9600"/><path d="M16 17c3 2 5 4 5 7a5 5 0 0 1-10 0c0-3 3-4 5-7z" fill="#ffc800"/></svg><b data-streak>0</b><span data-t>day streak</span></div>
        <div class="stat xp" title="XP" data-t-attr="title"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M18 2 6 18h8l-2 12 14-18h-8z" fill="#ffc800"/></svg><b data-xp>0</b><span data-t>XP</span></div>
        <div class="stat lessons" title="Lessons finished" data-t-attr="title"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 3 4 9 10 1-7 7 2 10-9-5-9 5 2-10-7-7 10-1z" fill="#7b2038"/></svg><b><span data-count>0</span>/{total}</b><span data-t>lessons</span></div>
      </div>
      <div class="card-box quest">
        <h2 data-t>Daily goal</h2>
        <p class="goal" data-goal data-t>Finish one lesson.</p>
        <div class="meter" aria-hidden="true"><i></i></div>
      </div>
      <TodayPanel />
      <p class="signin-hint" data-signin><span data-t>Your progress is saved in this browser.</span> <a href="/account/" data-t>Make an account</a> <span data-t>to keep it across devices.</span></p>
    </aside>

    <section class="path" aria-label="Lessons" data-t-attr="aria-label">
            {units.map((u) => (
        <div class="unit" id={u.key}>
          <div class="unit-banner">
            <div>
              <p class="unit-n"><span data-t>Unit</span> {u.n}</p>
              <h2 data-t>{u.name}</h2>
              <p class="unit-blurb" data-t>{u.blurb}</p>
            </div>
            <p class="unit-prog"><b data-unit-done={u.key}>0</b> <span data-t>of</span> {u.lessons.length}</p>
          </div>
          <ol class="nodes">
            {u.lessons.map((l) => (
              <li>
                <a class="node" href={`/learn/${l.data.slug}/`} data-slug={l.data.slug} data-unit={u.key} aria-label={`${l.data.title}. Lesson ${l.num}.`} data-title={l.data.title} data-num={l.num}>
                  <span class="n" aria-hidden="true">{l.num}</span>
                </a>
                <span class="node-label" data-title-label={l.data.slug}>{l.data.title}</span>
              </li>
            ))}
          </ol>
          {u.coming.length > 0 && (
            <details class="coming">
              <summary>{u.coming.length} <span data-t>more in this unit are being written</span></summary>
              <ul>{u.coming.map((c) => <li>{c.data.title}</li>)}</ul>
            </details>
          )}
        </div>
      ))}
      <div class="path-end">
        <p class="finis" data-t>That is the whole path for now.</p>
        <p>{total} <span data-t>lessons are ready.</span></p>
        <p><a class="btn ghost" href="/library/" data-t>Browse the library</a></p>
        <p class="signin-hint after" data-signin2><span data-t>Your progress is saved in this browser.</span> <a href="/account/" data-t>Make an account</a> <span data-t>to keep it across devices.</span></p>
      </div>
    </section>
  </div>

  <script>
    import { load, streak, totalXP, doneToday, syncDown } from '../lib/progress';
    import { T, getLang, applyLang } from '../lib/lang';
    import titlesEs from '../data/titles.es.json';
    import translated from '../data/translated.json';
    async function paint() {
      const s = load();
      const done = new Set(Object.keys(s.done));
      const nodes = [...document.querySelectorAll<HTMLAnchorElement>('.node')];
      let current: HTMLAnchorElement | null = null;
      const perUnit: Record<string, number> = {};
      for (const n of nodes) {
        const slug = n.dataset.slug!;
        if (done.has(slug)) { n.classList.add('done'); perUnit[n.dataset.unit!] = (perUnit[n.dataset.unit!] ?? 0) + 1; }
        else if (!current) current = n;
      }
      if (current) { current.classList.add('current'); const tag = document.createElement('span'); tag.className = 'start-tag'; tag.dataset.en = done.size ? 'Continue' : 'Start'; tag.textContent = T(tag.dataset.en); current.parentElement!.prepend(tag); }
      document.querySelectorAll<HTMLElement>('[data-unit-done]').forEach((el) => { el.textContent = String(perUnit[el.dataset.unitDone!] ?? 0); });
      (document.querySelector('[data-streak]') as HTMLElement).textContent = String(streak(s));
      (document.querySelector('[data-xp]') as HTMLElement).textContent = String(totalXP(s));
      (document.querySelector('[data-count]') as HTMLElement).textContent = String(done.size);
      const goal = document.querySelector<HTMLElement>('[data-goal]')!;
      goal.dataset.en = doneToday(s) ? 'Goal complete. Anything more is a bonus.' : 'Finish one lesson.'; goal.textContent = T(goal.dataset.en);
      goal.classList.toggle('met', doneToday(s));
      try { if (localStorage.getItem('cm-auth')) document.querySelectorAll('[data-signin],[data-signin2]').forEach((e) => e.remove()); } catch {}
      return current;
    }
    // Skipping ahead is allowed, but a confirmation screen nudges people back to the order.
    const dlg = document.createElement('div');
    dlg.className = 'skip-modal';
    dlg.hidden = true;
    dlg.innerHTML = '<div class="skip-card" role="dialog" aria-modal="true" aria-labelledby="skip-h"><h2 id="skip-h" data-t>Skip ahead?</h2><p class="skip-body"></p><p class="skip-note" data-t>The lessons build on each other. Doing them in order will help the later ones make sense.</p><button class="btn skip-back" type="button" data-t>Go to my next lesson</button><button class="btn ghost skip-go" type="button" data-t>Skip anyway</button></div>';
    document.body.appendChild(dlg);
    let target = '';
    const backBtn = dlg.querySelector<HTMLButtonElement>('.skip-back')!;
    const hide = () => { dlg.hidden = true; };
    dlg.addEventListener('click', (e) => { if (e.target === dlg) hide(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(); });
    dlg.querySelector('.skip-go')!.addEventListener('click', () => { location.href = target; });
    document.addEventListener('click', (e) => {
      const n = (e.target as HTMLElement).closest<HTMLAnchorElement>('.node');
      if (!n || n.classList.contains('done') || n.classList.contains('current')) return;
      const curNode = document.querySelector<HTMLAnchorElement>('.node.current');
      if (!curNode) return;
      e.preventDefault();
      target = n.href;
      const title = curNode.dataset.shown ?? curNode.dataset.title ?? '';
      dlg.querySelector('.skip-body')!.textContent = T('Your next lesson in order is') + ' "' + title + '".';
      backBtn.onclick = () => { location.href = curNode.href; };
      dlg.hidden = false;
      backBtn.focus();
    });
    // Titles, links and labels follow the chosen language. A translated lesson opens at /es/ or /la/.
    function localize() {
      const lang = getLang();
      applyLang(lang);
      document.querySelectorAll<HTMLAnchorElement>('.node').forEach((n) => {
        const slug = n.dataset.slug!;
        const shown = (lang === 'es' && (titlesEs as Record<string, string>)[slug]) || n.dataset.title!;
        n.dataset.shown = shown;
        n.setAttribute('aria-label', `${shown}. ${T('Lesson')} ${n.dataset.num}.`);
        const lab = n.parentElement?.querySelector('.node-label'); if (lab) lab.textContent = shown;
        const has = (translated as Record<string, string[]>)[slug]?.includes(lang);
        n.href = has ? `/${lang}/learn/${slug}/` : `/learn/${slug}/`;
      });
      document.querySelectorAll('.start-tag').forEach((t) => { const e = (t as HTMLElement).dataset.en; if (e) t.textContent = T(e); });
      const g = document.querySelector<HTMLElement>('[data-goal]'); if (g?.dataset.en) g.textContent = T(g.dataset.en);
      const sb = document.querySelector('.skip-back'); if (sb) sb.textContent = T('Go to my next lesson');
    }
    document.addEventListener('cm-lang', localize);
    let cur = await paint();
    localize();
    if (cur && Object.keys(load().done).length) cur.scrollIntoView({ block: 'center' });
    syncDown().then(async () => { document.querySelectorAll('.start-tag').forEach((t) => t.remove()); document.querySelectorAll('.node').forEach((n) => n.classList.remove('done', 'current')); await paint(); });
  </script>
</Base>
