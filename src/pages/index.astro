---
import Base from '../layouts/Base.astro';
import TodayPanel from '../components/TodayPanel.astro';
import { getUnits } from '../lib/lessons';
const units = await getUnits();
const total = units.reduce((n, u) => n + u.lessons.length, 0);
const coming = units.reduce((n, u) => n + u.coming.length, 0);
---
<Base title="Cruz-Mariaca" description="Short Catholic lessons you can finish in a few minutes, one screen at a time.">
  <div class="app">
    <aside class="rail" aria-label="Your progress">
      <div class="stats" data-stats>
        <div class="stat streak" title="Day streak"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M17 2c1 6 8 9 8 17a9 9 0 0 1-18 0c0-4 2-6 4-8 0 3 1 4 3 4 0-5 1-9 3-13z" fill="#ff9600"/><path d="M16 17c3 2 5 4 5 7a5 5 0 0 1-10 0c0-3 3-4 5-7z" fill="#ffc800"/></svg><b data-streak>0</b><span>day streak</span></div>
        <div class="stat xp" title="XP"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M18 2 6 18h8l-2 12 14-18h-8z" fill="#ffc800"/></svg><b data-xp>0</b><span>XP</span></div>
        <div class="stat lessons" title="Lessons finished"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 3 4 9 10 1-7 7 2 10-9-5-9 5 2-10-7-7 10-1z" fill="#1cb0f6"/></svg><b><span data-count>0</span>/{total}</b><span>lessons</span></div>
      </div>
      <div class="card-box quest">
        <h2>Daily goal</h2>
        <p class="goal" data-goal>Finish one lesson.</p>
        <div class="meter" aria-hidden="true"><i></i></div>
      </div>
      <TodayPanel />
      <p class="signin-hint" data-signin>Your progress is saved in this browser. <a href="/account/">Make an account</a> to keep it across devices.</p>
    </aside>

    <section class="path" aria-label="Lessons">
            {units.map((u) => (
        <div class="unit" id={u.key}>
          <div class="unit-banner">
            <div>
              <p class="unit-n">Unit {u.n}</p>
              <h2>{u.name}</h2>
              <p class="unit-blurb">{u.blurb}</p>
            </div>
            <p class="unit-prog"><b data-unit-done={u.key}>0</b> of {u.lessons.length}</p>
          </div>
          <ol class="nodes">
            {u.lessons.map((l) => (
              <li>
                <a class="node" href={`/learn/${l.data.slug}/`} data-slug={l.data.slug} data-unit={u.key} aria-label={`${l.data.title}. Lesson ${l.num}.`}>
                  <span class="n" aria-hidden="true">{l.num}</span>
                </a>
                <span class="node-label">{l.data.title}</span>
              </li>
            ))}
          </ol>
          {u.coming.length > 0 && (
            <details class="coming">
              <summary>{u.coming.length} more in this unit are being written</summary>
              <ul>{u.coming.map((c) => <li>{c.data.title}</li>)}</ul>
            </details>
          )}
        </div>
      ))}
      <div class="path-end">
        <p class="finis">That is the whole path for now.</p>
        <p>{total} lessons are ready. {coming} more across these units are outlined and on the way, so there is always an end in sight and never a feed.</p>
        <p><a class="btn ghost" href="/library/">Browse the library</a></p>
        <p class="signin-hint after" data-signin2>Your progress is saved in this browser. <a href="/account/">Make an account</a> to keep it across devices.</p>
      </div>
    </section>
  </div>

  <script>
    import { load, streak, totalXP, doneToday, syncDown } from '../lib/progress';
    async function paint() {
      const s = load();
      const done = new Set(Object.keys(s.done));
      const nodes = [...document.querySelectorAll<HTMLAnchorElement>('.node')];
      let current: HTMLAnchorElement | null = null;
      const perUnit: Record<string, number> = {};
      for (const n of nodes) {
        const slug = n.dataset.slug!;
        if (done.has(slug)) { n.classList.add('done'); perUnit[n.dataset.unit!] = (perUnit[n.dataset.unit!] ?? 0) + 1; }
        else if (!current) current = n;
      }
      if (current) { current.classList.add('current'); const tag = document.createElement('span'); tag.className = 'start-tag'; tag.textContent = done.size ? 'Continue' : 'Start'; current.parentElement!.prepend(tag); }
      document.querySelectorAll<HTMLElement>('[data-unit-done]').forEach((el) => { el.textContent = String(perUnit[el.dataset.unitDone!] ?? 0); });
      (document.querySelector('[data-streak]') as HTMLElement).textContent = String(streak(s));
      (document.querySelector('[data-xp]') as HTMLElement).textContent = String(totalXP(s));
      (document.querySelector('[data-count]') as HTMLElement).textContent = String(done.size);
      const goal = document.querySelector<HTMLElement>('[data-goal]')!;
      goal.textContent = doneToday(s) ? 'Goal complete. Anything more is a bonus.' : 'Finish one lesson.';
      goal.classList.toggle('met', doneToday(s));
      try { if (localStorage.getItem('cm-auth')) document.querySelectorAll('[data-signin],[data-signin2]').forEach((e) => e.remove()); } catch {}
      return current;
    }
    let cur = await paint();
    if (cur && Object.keys(load().done).length) cur.scrollIntoView({ block: 'center' });
    syncDown().then(async () => { document.querySelectorAll('.start-tag').forEach((t) => t.remove()); document.querySelectorAll('.node').forEach((n) => n.classList.remove('done', 'current')); await paint(); });
  </script>
</Base>
