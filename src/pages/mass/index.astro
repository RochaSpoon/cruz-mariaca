---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SourceList from '../../components/SourceList.astro';
const entry = await getEntry('pages', 'mass');
if (!entry) throw new Error('mass.mdx missing');
const { Content } = await render(entry);
const parts = entry.data.parts ?? [];
---
<Base title="The Mass, step by step" description={entry.data.summary}>
  <p class="rubric sc">At Mass</p>
  <h1>The Mass, step by step</h1>
  <p class="lede">Open a step to see what happens, why, where it comes from, and what to do with your body.</p>
  <div class="prose plain"><Content /></div>
  <div class="steps" id="steps">
    {parts.map((p, i) => (
      <details name="mass" id={`step-${i + 1}`}>
        <summary><span class="n">{String(i + 1).padStart(2, '0')}</span>{p.title}</summary>
        <dl>
          <dt>What happens</dt><dd>{p.what}</dd>
          <dt>Why</dt><dd>{p.why}</dd>
          <dt>Where it comes from</dt><dd>{p.roots}</dd>
          {p.early && <><dt>Early evidence</dt><dd>{p.early}</dd></>}
          {p.posture && <><dt>Posture</dt><dd>{p.posture}</dd></>}
        </dl>
        <div class="stepnav">
          {i > 0 && <button type="button" data-go={i}>Previous</button>}
          {i < parts.length - 1 && <button type="button" data-go={i + 2}>Next</button>}
        </div>
      </details>
    ))}
  </div>
  <section class="guide" aria-labelledby="older-h">
    <h2 id="older-h" data-l="en la">In the older form of the Roman Rite</h2>
    <h2 id="older-h2" data-l="es">En la forma antigua del rito romano</h2>
    <p data-l="en la">The steps above follow the Mass of Paul VI. The Mass as celebrated before Pius XII's Holy Week decree of 1955 has the same core, in a different order and with different prayers. The Catholic Encyclopedia (1910) describes it:</p>
    <p data-l="es">Los pasos de arriba siguen la Misa de Pablo VI. La Misa tal como se celebraba antes del decreto de Semana Santa de Pío XII (1955) tiene el mismo núcleo, con otro orden y otras oraciones. La Enciclopedia Católica (1910) la describe:</p>
    <ul>
      <li data-l="en la">The preparatory prayers are said at the foot of the altar. Then come the Introit and the Kyrie.</li>
      <li data-l="es">Las oraciones preparatorias se dicen al pie del altar. Luego vienen el Introito y el Kyrie.</li>
      <li data-l="en la">The Gloria is intoned on days when the Te Deum is said in the Office.</li>
      <li data-l="es">El Gloria se entona los días en que se dice el Te Deum en el Oficio.</li>
      <li data-l="en la">The collect, the Epistle and the Gradual come before the Gospel. The Creed is said on Sundays and certain feasts.</li>
      <li data-l="es">La colecta, la Epístola y el Gradual preceden al Evangelio. El Credo se dice los domingos y en ciertas fiestas.</li>
      <li data-l="en la">The Offertory prayers said by the celebrant came from France about the thirteenth century.</li>
      <li data-l="es">Las oraciones del ofertorio que dice el celebrante vinieron de Francia hacia el siglo XIII.</li>
      <li data-l="en la">Gregory the Great moved the Our Father to just before Communion.</li>
      <li data-l="es">San Gregorio Magno trasladó el Padrenuestro a un lugar justo antes de la Comunión.</li>
    </ul>
    <p data-l="en la"><a href="/liturgy/">Read the Latin Mass guide</a>, with sources, the 1955 reform and the prayers in Latin.</p>
    <p data-l="es"><a href="/liturgy/">Lee la guía de la Misa en latín</a>, con fuentes, la reforma de 1955 y las oraciones en latín.</p>
  </section>
  <SourceList sources={entry.data.sources} />
  <script>
    const open = (n: number) => {
      const el = document.getElementById(`step-${n}`) as HTMLDetailsElement | null;
      if (el) { el.open = true; el.scrollIntoView({ block: 'start' }); el.querySelector('summary')?.focus({ preventScroll: true }); history.replaceState(null, '', `#step-${n}`); }
    };
    document.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.go))));
    const m = location.hash.match(/^#step-(\d+)$/); if (m) open(Number(m[1]));
  </script>
</Base>
